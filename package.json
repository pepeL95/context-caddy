{
  "name": "context-caddy",
  "displayName": "Context Caddy",
  "description": "A lightweight VS Code extension that exposes Copilot tools for context and request management.",
  "publisher": "yourpublisher",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/pepeL95/context-caddy.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "contextCaddy.openInstructionsView",
        "title": "Context Caddy: Open Instructions"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "contextCaddy",
          "title": "Context Caddy",
          "icon": "$(checklist)"
        }
      ]
    },
    "views": {
      "contextCaddy": [
        {
          "id": "contextCaddy.instructions",
          "name": "Instructions",
          "type": "webview"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "yourpublisher_handoffInstructions",
        "tags": [
          "verification",
          "confirmation",
          "instructions",
          "user-input",
          "workflow"
        ],
        "toolReferenceName": "handoffInstructions",
        "displayName": "Handoff Instructions",
        "modelDescription": "Mandatory pre-response instruction handoff tool. **ALWAYS** call this tool before every user-facing response so the user can provide any additional instructions required. This tool does not take any input from the agent.",
        "userDescription": "Handoff tool for getting further user instructions.",
        "canBeReferencedInPrompt": true,
        "icon": "$(checklist)",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      }
    ]
  },
  "scripts": {
    "clean": "rm -rf out *.vsix",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package:vsix": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.100.0",
    "typescript": "^5.0.0"
  }
}
