{
  "name": "context-caddy",
  "displayName": "Context Caddy",
  "description": "A lightweight VS Code extension that exposes Copilot tools for context and request management.",
  "publisher": "yourpublisher",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/pepeL95/context-caddy.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "contextCaddy.openTaskStateView",
        "title": "Context Caddy: Open Task State"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "contextCaddy",
          "title": "Context Caddy",
          "icon": "$(checklist)"
        }
      ]
    },
    "views": {
      "contextCaddy": [
        {
          "id": "contextCaddy.taskState",
          "name": "Task State",
          "type": "webview"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "yourpublisher_taskStateVerifier",
        "tags": [
          "verification",
          "confirmation",
          "task-state",
          "user-input"
        ],
        "toolReferenceName": "taskStateVerifier",
        "displayName": "Task State Verifier",
        "modelDescription": "Task-state verification tool. The model should call this before user-facing responses when it needs the latest user-approved task state, approval, or request context. This tool does not collect input during invocation. Instead, it returns the current text saved in the Context Caddy Task State view unchanged.",
        "userDescription": "Return the saved task-state text from the Context Caddy Task State view.",
        "canBeReferencedInPrompt": true,
        "icon": "$(checklist)",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      }
    ]
  },
  "scripts": {
    "clean": "rm -rf out *.vsix",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package:vsix": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.100.0",
    "typescript": "^5.0.0"
  }
}
